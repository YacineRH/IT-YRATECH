# Base PostgreSQL (dev local ou conteneur docker compose)
DATABASE_URL=postgres://yratech:yratech@localhost:5432/yratech
# Base dediee aux tests d'integration de l'API
TEST_DATABASE_URL=postgres://yratech:yratech@localhost:5432/yratech_test
# Port d'ecoute de l'API
PORT=3000
# Origine autorisee par CORS en dev (Vite)
CORS_ORIGIN=http://localhost:5173

# --- Deploiement docker compose (VPS) ---
POSTGRES_PASSWORD=changer-moi
# Port local publie par le conteneur web, cible du reverse proxy TLS
WEB_PORT=8080
# Mettre a false quand la synchronisation de veille reelle tourne (phase 4)
ALERTES_DEMO=true
